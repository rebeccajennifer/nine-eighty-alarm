@startuml

' Hides the 'c' that appears next to classes
hide circle

skinparam DefaultFontName "Monospaced"
skinparam DefaultFontSize "10"
skinparam MinClassWidth 100

'_______________________________________________________________________
' Colors
'_______________________________________________________________________
' Apply background color: Use  $color_var_name  (colors defined w/ #)
' Apply outline    color: Use #$color_var_name  (colors defined w/ #)
'
' e.g. class ClassName #$outline_color $bg_color
'
!$color_0= "#00afd7"
!$color_1= "#d72faf"
!$color_2= "#000000"

!$def_bg_= "#eeeeee"

skinparam ClassBackgroundColor  $def_bg_
skinparam ClassBorderColor      $color_1

'_______________________________________________________________________
' Global params
'_______________________________________________________________________


'_______________________________________________________________________
' Legend
'_______________________________________________________________________
' --|> Inheritance, child on top  e.g. ChildClass  --|> ParentClass
' <|-- Inheritance, parent on top e.g. ParentClass --|> ChildClass
' *--  Composition
' o--  Aggregation
' --   Association
' -->  Directed Association
' ..>  Dependency
' <|.. Realization
'_______________________________________________________________________

class TopLevel
class TimeCalcs
class FluxClock
class MomentarySwitch
class FluxAlarm
class Adafruit_AlphaNum4

class TimeController
class TimeDisplay

hide  TimeController      members
hide  TimeDisplay         members
hide  TopLevel            members
hide  TimeCalcs           members
hide  FluxClock           members
hide  MomentarySwitch     members
hide  FluxAlarm           members
hide  Adafruit_AlphaNum4  members


TopLevel        --> TimeCalcs
TopLevel        --> TimeController

TimeController  --> FluxClock
TimeController  --> TimeDisplay
TimeController  --> MomentarySwitch

FluxClock       --> FluxAlarm
TimeDisplay     --> Adafruit_AlphaNum4

'json "Class Descriptions" as desc_tbl {
'  "TopLevel"            : "Top level functionality."
', "TimeCalcs"           : "Static time constants and calculations."
', "FluxClock"           : "Clock object and setter functions based on hardware implementation."
', "MomentarySwitch"     : "State logic for buttons."
', "FluxAlarm"           : "Alarm information."
', "Adafruit_AlphaNum4"  : "Third party class to control LED display."
', "TimeController"      : "Control logic for time."
', "TimeDisplay"         : ""
'}

object Descriptions {
 TopLevel            : Top level functionality.
 TimeCalcs           : Static time constants and calculations.
 FluxClock           : Clock object and setter functions based on hardware implementation.
 MomentarySwitch     : State logic for buttons.
 FluxAlarm           : Alarm information.
 Adafruit_AlphaNum4  : Third party class to control LED display.
 TimeController      : Control logic for time.
 TimeDisplay         :
}

@enduml