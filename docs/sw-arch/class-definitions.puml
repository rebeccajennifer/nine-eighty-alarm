@startuml nine-eighty-alarm-class-definitions

!include nine-eighty.puml

'_______________________________________________________________________
hide Adafruit_AlphaNum4 members
hide DS3231             members
hide LatchingSwitch     members

'_______________________________________________________________________
class QnxDriver
{
  +TimeCtrl time_ctrl_
  +UserCtrl user_ctrl_
  +AlphaDisplay alpha_disp_
}

'_______________________________________________________________________
class ClockWrapper
{
  +DS3231  rtc_

  +uint8_t get_weekday_mask ()
  +uint8_t get_yr           ()
  +uint8_t get_month        ()
  +uint8_t get_date         ()
  +uint8_t get_weekday      ()
  +uint8_t get_hr           ()
  +uint8_t get_min          ()
  +uint8_t get_sec          ()

}

'_______________________________________________________________________
class TimeCtrl
{
  -ClockWrapper  clock_
  -AlphaDisplay* display_
  +bool is_on_fri ()
  +void set_year  (short)
  +void set_month (uint8_t)
  +void set_day   (uint8_t)
  +void set_hr    (uint8_t)
  +void set_min   (uint8_t)
  +void set_sec   (uint8_t)
}

'_______________________________________________________________________
class AlphaDisplay
{
  -Adafruit_AlphaNum4 led_segments_
  +void write_disp_str    (const char*)
  +void write_disp_str_num(const char* str, uint8_t num)
  +void write_disp_hr_min (uint8_t hr     , uint8_t min)
  +void write_disp_time   (uint8_t        , uint8_t)
}

'_______________________________________________________________________
enum TimeSetState <<enumeration>> {
}

class UserCtrl
{
  -AlphaDisplay*   display_

  -MomentarySwitch inc_btn_
  -MomentarySwitch dec_btn_
  -MomentarySwitch snooze_btn_
  -LatchingSwitch  alarm_toggle_

  -TimeSetState    time_set_state_

  +void set_time()
}

hide TimeSetState members

UserCtrl +-- TimeSetState

'_______________________________________________________________________
class Alarm
{
  -uint8_t alarm_days_ // 8-bit mask
  -uint8_t hr_
  -uint8_t min_
  -bool    triggered_
  +bool    is_alarm_time(uint8_t weekday, uint8_t hr, uint8_t min)
}

'_______________________________________________________________________
class AudioCtrl
{
  -SpeakerWrapper speaker_
  -AlarmSound selected_alarm_sound_
  +void play_alarm_sound()
}

'_______________________________________________________________________
enum InputType <<enumeration>> {
NONE
LONG
SHORT
DOUBLE
TRIPLE
}

enum SwitchState <<enumeration>> {
IDLE
PRESS
HOLD
RELEASE
WAIT
}

hide InputType   methods
hide SwitchState methods

MomentarySwitch +-- InputType
MomentarySwitch +-- SwitchState

'_______________________________________________________________________
class MomentarySwitch
{
  -int on_value_
  -int reading_

  -int settle_time_in_ms_
  -int long_hold_time_in_ms_
  -int short_hold_time_in_ms_
  -int mult_input_time_gap_

  -int sw_state_
  -int prev_state_

  -int prev_debounced_input_
  -int multi_input_count_

  -unsigned long prev_ms_
  -unsigned long on_time_ms_
  -unsigned long release_time_ms_
  -unsigned long time_since_off_

  -SwitchState sw_state_type_

  +InputType get_input_type ()
  +int       debounce_input ()
  +int       get_pin        ()
  +int       get_reading    ()
  +bool      is_short_press ()
}


@enduml
